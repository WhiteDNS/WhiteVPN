<?xml version="1.0" encoding="utf-8"?>
<!--
    Applies below Android 12 (API 31); newer releases use data_extraction_rules.xml.
    Backup is already off via `android:allowBackup="false"` — this keeps the intent explicit.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
