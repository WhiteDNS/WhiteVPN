+func TestWhiteVPNGeneratorConfig(t *testing.T) {
+	input := whitevpnControl + `external-ui: ui
+external-ui-url: https://example.com/dashboard.zip
+external-ui-name: dashboard
+rule-anchor:
+  domain: &domain {type: http, interval: 86400, behavior: domain, format: mrs}
+rule-providers:
+  example: {<<: *domain, url: 'https://example.com/rules.mrs'}
+`
+	raw := DefaultRawConfig()
+	if err := unmarshalWhiteVPNConfig([]byte(input), raw); err != nil {
+		t.Fatal(err)
+	}
+	if raw.ExternalUI != "" || raw.ExternalUIURL != "" || raw.ExternalUIName != "" {
+		t.Fatal("dashboard settings reached the Android runtime")
+	}
+	provider := raw.RuleProvider["example"]
+	if provider["type"] != "http" || provider["behavior"] != "domain" || provider["format"] != "mrs" || provider["url"] != "https://example.com/rules.mrs" {
+		t.Fatalf("rule provider lost merged fields: %v", provider)
+	}
+}
 
