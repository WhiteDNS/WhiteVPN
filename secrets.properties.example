# Copy this file to secrets.properties and fill in the real values.
# Do not commit secrets.properties.
#
# These are the AES-GCM passphrases used to decrypt the Mihomo subscription payload and the
# encrypted clean-IP list served by the Cloudflare Workers endpoints. Release builds refuse to
# assemble when they are missing; debug builds compile but cannot decrypt either payload.
#
# The equivalent environment variables take precedence and are what CI should use:
#   WHITEDNS_MIHOMO_SUBSCRIPTION_KEY
#   WHITEDNS_ENCRYPTED_IP_LIST_KEY
#   WHITEDNS_PRIVATE_MIHOMO_SUBSCRIPTION_URL

mihomoSubscriptionKey=change-me
encryptedIpListKey=change-me
privateMihomoSubscriptionUrl=https://example.com/private-subscription
